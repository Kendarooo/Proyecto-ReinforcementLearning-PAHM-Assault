{
  "seed": 42,

  "env": {
    "frame_width": 84,
    "frame_height": 84,
    "n_frames": 4,
    "clip_rewards": true
  },

  "agent": {
    "learning_rate": 0.0001,
    "gamma": 0.99,
    "batch_size": 32,
    "target_update_freq": 1000,
    "epsilon_start": 1.0,
    "epsilon_end": 0.05,
    "epsilon_schedule": "linear",
    "epsilon_decay_steps": 300000,
    "checkpoint_dir": "checkpoints"
  },

  "training": {
    "n_episodes": 3000,
    "replay_buffer_capacity": 100000,
    "min_buffer_size": 10000,
    "checkpoint_every": 25,
    "eval_every": 25,
    "eval_episodes": 5,
    "log_every": 1,
    "save_best": true
  },

  "wandb": {
    "project": "demon-attack-dqn",
    "entity": null,
    "group": "stage-0-demonattack",
    "job_type": "train",
    "tags": ["stage-0", "double-dqn", "demonattack", "epsilon-schedule"]
  }
}
